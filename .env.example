# Опционально: если задать оба значения здесь, панель управления скроет
# поля Client ID / Client Secret на вкладке "Авторизация Twitch" и будет
# использовать эти значения автоматически (перезаписывают то, что в config.json).
# Скопируй этот файл в .env и заполни, либо просто вводи ключи через админку —
# тогда .env вообще не нужен.

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
