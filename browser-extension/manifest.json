{
  "manifest_version": 3,
  "name": "Overdeck",
  "version": "1.2.1",
  "description": "Overdeck в браузере: «Сейчас играет», авто-сбор баллов канала Twitch, смайлы 7TV/BTTV/FFZ, панель смайлов и 1080p (бета).",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.twitch.tv/*",
    "https://usher.ttvnw.net/*",
    "https://7tv.io/*",
    "https://cdn.7tv.app/*",
    "https://api.betterttv.net/*",
    "https://cdn.betterttv.net/*",
    "https://*.frankerfacez.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.twitch.tv/*",
        "https://twitch.tv/*",
        "https://m.twitch.tv/*"
      ],
      "js": [
        "twitch.js"
      ],
      "css": [
        "twitch.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Overdeck",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}